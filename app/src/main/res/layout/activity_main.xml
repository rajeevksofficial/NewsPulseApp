<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_news"
            app:tint="@color/primary_red" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NewsPulse"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLiveIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="● LIVE"
                    android:textColor="@color/primary_red"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_channel_badge"
                    android:backgroundTint="@color/primary_red_glow"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvFeedStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOI • HT • NDTV • The Hindu • BBC"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Share Digest Button -->
        <ImageButton
            android:id="@+id/btnShareDigest"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_share"
            android:contentDescription="Share Daily Digest"
            app:tint="@color/text_primary"
            android:layout_marginEnd="8dp" />

        <!-- Refresh Button -->
        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Refresh News Feeds"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="@string/search_news_hint"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/btnClearSearch"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_clear"
            android:visibility="gone"
            android:contentDescription="Clear Search" />
    </LinearLayout>

    <!-- Channel Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/llChannelChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Feeds"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="13sp"
                android:background="@drawable/bg_chip_active"
                android:paddingHorizontal="16dp"
                android:paddingVertical="7dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipToi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Times of India"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipHt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hindustan Times"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipNdtv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NDTV"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipHindu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The Hindu"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipBbc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BBC News"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipSaved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📑 Saved"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- News Feed List with SwipeRefreshLayout -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNews"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/llEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_news"
                    app:tint="@color/text_muted" />

                <TextView
                    android:id="@+id/tvEmptyMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No news stories found"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Pull down or tap refresh to update feeds"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
